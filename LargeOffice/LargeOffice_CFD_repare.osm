OS:EnergyManagementSystem:Program,
  {12e4dec2-1ad5-4c39-871e-e89dd77ed31a}, !- Handle
  ems_VAV_top_WITH_REHEAT_OptimumStartProg0, !- Name
  IF DaylightSavings==0 && DayOfWeek>1 && Hour==5 && {a75feeab-0675-4b57-bdb1-044e15e8ff6b}<23.9 && {a75feeab-0675-4b57-bdb1-044e15e8ff6b}>1.7, !- Program Line 1
  SET {fa12dcee-fcd6-4a1e-acf7-6169213ad9a0} = 29.4, !- Program Line 2
  SET {7dca587f-d2ac-4464-a779-c87ecd1e95a9} = 15.6, !- Program Line 3
  ELSEIF DaylightSavings==0 && DayOfWeek==1 && Hour==7 && {a75feeab-0675-4b57-bdb1-044e15e8ff6b}<23.9 && {a75feeab-0675-4b57-bdb1-044e15e8ff6b}>1.7, !- Program Line 4
  SET {fa12dcee-fcd6-4a1e-acf7-6169213ad9a0} = 29.4, !- Program Line 5
  SET {7dca587f-d2ac-4464-a779-c87ecd1e95a9} = 15.6, !- Program Line 6
  ELSEIF DaylightSavings==1 && DayOfWeek>1 && Hour==4 && {a75feeab-0675-4b57-bdb1-044e15e8ff6b}<23.9 && {a75feeab-0675-4b57-bdb1-044e15e8ff6b}>1.7, !- Program Line 7
  SET {fa12dcee-fcd6-4a1e-acf7-6169213ad9a0} = 29.4, !- Program Line 8
  SET {7dca587f-d2ac-4464-a779-c87ecd1e95a9} = 15.6, !- Program Line 9
  ELSEIF DaylightSavings==1 && DayOfWeek==1 && Hour==6 && {a75feeab-0675-4b57-bdb1-044e15e8ff6b}<23.9 && {a75feeab-0675-4b57-bdb1-044e15e8ff6b}>1.7, !- Program Line 10
  SET {fa12dcee-fcd6-4a1e-acf7-6169213ad9a0} = 29.4, !- Program Line 11
  SET {7dca587f-d2ac-4464-a779-c87ecd1e95a9} = 15.6, !- Program Line 12
  ELSE,                                   !- Program Line 13
  SET {fa12dcee-fcd6-4a1e-acf7-6169213ad9a0} = NULL, !- Program Line 14
  SET {7dca587f-d2ac-4464-a779-c87ecd1e95a9} = NULL, !- Program Line 15
  ENDIF;                                  !- Program Line 16

